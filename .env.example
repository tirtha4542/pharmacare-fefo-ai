# Server Environment & Port
PORT=5000
NODE_ENV=production

# Database MySQL 8.0 Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=pharma_user
DB_PASSWORD=your_db_password_here
DB_NAME=pharmacy_db
DB_CONNECTION_LIMIT=20
DB_MAX_IDLE=10

# Security & JWT Tokens (Must be a long random secret in production)
JWT_SECRET=your_jwt_secret_key_here_min_16_chars
JWT_EXPIRES_IN=1d

# CORS & Rate Limiting
CORS_ORIGIN=*
RATE_LIMIT_GLOBAL=200
