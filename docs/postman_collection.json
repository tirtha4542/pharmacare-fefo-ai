        {
          "name": "Register Customer",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Customer\",\n  \"email\": \"customer.new@example.com\",\n  \"password\": \"CustomerPassword123!\",\n  \"phone\": \"+8801700000099\",\n  \"address\": \"Mirpur 10, Dhaka\"\n}"
